# Copy to .env in this directory. Every backend binary (api, producer,
# consumer, email-worker, webhook-worker) reads it via dotenvy, relative to
# the directory it is started from.

# --- required by everything ---
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/better-uptime
REDIS_URL=redis://127.0.0.1/

# --- required by api ---
JWT_SECRET=change-me
# Shared secret the channel-gateway uses to call /internal/* routes. Must match
# the value in channel-gateway/.env.
INTERNAL_API_SECRET=change-me
# Path to a MaxMind GeoLite2-City.mmdb, used to geolocate traceroute hops.
GEOIP_DB_PATH=/var/lib/geoip/GeoLite2-City.mmdb

# --- required by api (AI assistant) ---
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o

# --- required by consumer ---
# Labels the region that checks are recorded from.
REGION_ID=india
REGION_NAME=India

# --- required by email-worker ---
# Without these the worker exits at startup and no alert emails are sent.
# Any SMTP relay works; these are the settings for that account.
SMTP_HOST=smtp.example.com
SMTP_USER=livestack
SMTP_PASS=change-me
SMTP_FROM=alerts@example.com
